---
// Own footer for SAWO_ECOM — simplified, recreated locally from
// REACT_SITE's Footer.jsx (same near-black band, same social links).
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <img src="/logo.webp" alt="SAWO" width="140" height="89" />
      <p>Genuine SAWO sauna heaters, steam generators, controls, and accessories.</p>
    </div>

    <div class="footer-social">
      <a href="https://facebook.com/SAWOsaunaworld" target="_blank" rel="noopener noreferrer" aria-label="SAWO on Facebook"><i class="fab fa-facebook-f"></i></a>
      <a href="https://www.instagram.com/sawosauna/" target="_blank" rel="noopener noreferrer" aria-label="SAWO on Instagram"><i class="fab fa-instagram"></i></a>
      <a href="https://ph.linkedin.com/company/sawo-inc" target="_blank" rel="noopener noreferrer" aria-label="SAWO on LinkedIn"><i class="fab fa-linkedin-in"></i></a>
      <a href="https://www.youtube.com/@SAWOsauna" target="_blank" rel="noopener noreferrer" aria-label="SAWO on YouTube"><i class="fab fa-youtube"></i></a>
      <a href="mailto:help@sawo.com" aria-label="Email SAWO support"><i class="fas fa-envelope"></i></a>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <span>&copy; {year} SAWO. All rights reserved.</span>
  </div>
</footer>

<style>
  .site-footer { background: var(--ink); color: #fff; padding: 40px 0 0; margin-top: 60px; }
  .footer-inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    padding-bottom: 28px;
  }
  .footer-brand img { height: 48px; width: auto; margin-bottom: 10px; filter: brightness(0) invert(1); }
  .footer-brand p { max-width: 380px; font-size: .82rem; color: #c9c2b8; margin: 0; }

  .footer-social { display: flex; gap: 10px; }
  .footer-social a {
    width: 36px; height: 36px; border-radius: 50%;
    background: rgba(255,255,255,.08);
    display: flex; align-items: center; justify-content: center;
    transition: background .2s ease;
  }
  .footer-social a:hover { background: var(--brown-text); }

  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,.12);
    padding: 16px 0;
    font-size: .75rem;
    color: #9c948a;
    text-align: center;
  }
</style>
