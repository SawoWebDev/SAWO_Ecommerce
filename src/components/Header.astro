---
// Kept deliberately minimal — logo + cart only, no nav or search. The
// search box lives on the catalog page itself now (next to the category
// filters, where it's actually useful), not duplicated up here.
---
<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand">
      <img src="/logo.webp" alt="SAWO" width="120" height="76" />
    </a>

    <button class="icon-btn" aria-label="Cart">
      <i class="fa-solid fa-bag-shopping"></i>
    </button>
  </div>
</header>

<style>
  .site-header {
    background: var(--surface);
    border-bottom: 1px solid var(--border-soft);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 14px 32px;
  }
  .brand img { height: 48px; width: auto; }

  .icon-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-alt);
    border: none;
    color: var(--brown-deep);
    font-size: 1rem;
    transition: background .2s ease;
  }
  .icon-btn:hover { background: var(--border); }

  @media (max-width: 640px) {
    .header-inner { padding: 12px 18px; }
  }
</style>
