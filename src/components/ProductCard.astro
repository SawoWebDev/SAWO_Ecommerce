---
import type { Product } from "../lib/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;

const category = product.categories?.[0] ?? product.brand ?? null;

const hasPrice = product.price !== null && product.price > 0;
const hasDiscount = hasPrice && product.compare_at_price !== null && product.compare_at_price! > product.price!;

const currencyFormatter = new Intl.NumberFormat("en-PH", {
  style: "currency",
  currency: product.currency || "PHP",
  minimumFractionDigits: 0,
  maximumFractionDigits: 2,
});

// Placeholder price/rating/SKU generator — product_commerce rows for most
// accessories aren't priced yet (see products.ts's comment on those fields
// being null pre-CMS), so this fills the card in for a "what will this look
// like with real data" preview. Seeded from the product's own id/slug so
// values stay stable across reloads instead of reshuffling every request;
// swap out once product_commerce is actually populated.
function hashStr(s: string): number {
  let h = 0;
  for (let i = 0; i < s.length; i++) { h = (h << 5) - h + s.charCodeAt(i); h |= 0; }
  return Math.abs(h);
}
function rand01(seed: string): number {
  return (hashStr(seed) % 10000) / 10000;
}
function niceAmount(x: number): number {
  return Math.max(199, Math.round(x / 5) * 5);
}

const PRICE_RANGE_BY_CATEGORY: Record<string, [number, number]> = {
  Pails: [900, 2600], Ladles: [650, 2200], "Pail Shower": [2400, 3800],
  Thermometers: [800, 3000], "Combined Meters": [800, 3000], Hygrometers: [800, 3000],
  Clocks: [600, 2400], "Sand Timers": [600, 2400], "Clocks & Timers": [600, 2400],
  "Sauna Lights": [1400, 5200], "Light Covers": [1400, 5200], "Lights & Covers": [1400, 5200],
  Headrests: [1200, 3400], Backrests: [1200, 3400], "Headrest & Backrest": [1200, 3400],
  "Doors & Handles": [1800, 38000], "Sauna Doors": [1800, 38000], "Sauna Handles": [1800, 38000],
  Benches: [1500, 18000], "Wooden Floor Mats": [1200, 4200], "Cloth Hangers": [600, 1800], "Benches & Floor Tiles": [1500, 18000],
  Kivistone: [2400, 11200],
  "Ventilation & Miscellaneous": [600, 5200], Ventilations: [600, 5200], "Add-Ons": [600, 5200],
  "Accessory Sets": [3200, 14400],
};
const DEFAULT_PRICE_RANGE: [number, number] = [800, 4800];

const seed = product.slug || product.id;
const [priceMin, priceMax] = PRICE_RANGE_BY_CATEGORY[category ?? ""] ?? DEFAULT_PRICE_RANGE;

const placeholderPrice = hasPrice ? null : niceAmount(priceMin + rand01(seed + "|price") * (priceMax - priceMin));
const placeholderIsDiscounted = !hasPrice && rand01(seed + "|disc") < 0.28;
const placeholderCompareAt = placeholderIsDiscounted
  ? niceAmount(placeholderPrice! * (1.12 + rand01(seed + "|discamt") * 0.22))
  : null;

const displayPrice = hasPrice ? product.price! : placeholderPrice;
const displayCompareAt = hasDiscount ? product.compare_at_price! : placeholderCompareAt;
const showDiscount = hasDiscount || placeholderIsDiscounted;
const save = showDiscount && displayCompareAt !== null ? displayCompareAt - displayPrice! : null;

const placeholderSku = product.sku || (seed ? seed.toUpperCase().replace(/[^A-Z0-9]+/g, "-").slice(0, 16) : null);
const freeShipping = (displayPrice ?? 0) >= 1500 || rand01(seed + "|ship") < 0.3;

const hasRating = product.rating_average !== null && product.rating_average! > 0;
const placeholderRating = hasRating ? null : Math.round((4.2 + rand01(seed + "|rating") * 0.8) * 2) / 2;
const placeholderReviewCount = hasRating ? null : 4 + Math.floor(rand01(seed + "|reviews") * 260);

const displayRating = hasRating ? product.rating_average! : placeholderRating!;
const displayReviewCount = hasRating ? product.rating_count! : placeholderReviewCount!;
const filledStars = Math.round(displayRating * 2) / 2;

const isBestSeller = !!product.featured;
---
<div class="product-card">
  <div class="product-photo">
    {isBestSeller ? (
      <span class="bestseller-badge">Best Seller</span>
    ) : save !== null && (
      <span class="save-badge">SAVE {currencyFormatter.format(save)}</span>
    )}
    <button class="wishlist-btn" type="button" aria-label="Add to wishlist">
      <i class="fa-regular fa-heart"></i>
    </button>
    {product.thumbnail ? (
      <img src={product.thumbnail} alt={product.name} loading="lazy" />
    ) : (
      <i class="fa-regular fa-image product-photo-fallback"></i>
    )}
  </div>
  <div class="product-body">
    {placeholderSku && <span class="product-sku">CODE {placeholderSku}</span>}
    <h3>{product.name}</h3>
    <div class="rating-row">
      <span class="stars">
        {Array.from({ length: 5 }).map((_, i) => {
          const diff = filledStars - i;
          return diff >= 1 ? "★" : diff >= 0.5 ? "⯨" : "☆";
        })}
      </span>
      {displayReviewCount > 0 && <span>({displayReviewCount} reviews)</span>}
    </div>
    {freeShipping && (
      <span class="ship-tag"><i class="fa-solid fa-truck-fast"></i> Free Shipping</span>
    )}
    <div class="price-row">
      {displayPrice !== null ? (
        <>
          <span class="price-now">{currencyFormatter.format(displayPrice)}</span>
          {showDiscount && displayCompareAt && <span class="price-was">{currencyFormatter.format(displayCompareAt)}</span>}
        </>
      ) : <span class="price-unavailable">Price on request</span>}
    </div>
  </div>
  <div class="product-footer">
    <button class="add-cart-btn" type="button"><i class="fa-solid fa-bag-shopping"></i> Add to Cart</button>
  </div>
</div>

<style>
  .product-card {
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: all .25s ease;
    display: flex;
    flex-direction: column;
  }
  .product-card:hover { box-shadow: var(--shadow-md); transform: translateY(-4px); border-color: var(--border); }

  .product-photo {
    aspect-ratio: 1/.9;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(155deg, var(--bg-alt), #fff 65%);
    padding: 14px;
  }
  .product-photo img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .product-photo-fallback { font-size: 2.2rem; color: var(--brown-light); }

  .save-badge {
    position: absolute; top: 12px; left: 12px; background: var(--terracotta); color: #fff;
    font-size: .6rem; font-weight: 800; letter-spacing: .02em; padding: 5px 9px; border-radius: 5px; z-index: 2;
  }
  .bestseller-badge {
    position: absolute; top: 12px; left: 12px; background: linear-gradient(135deg, var(--brown-text), var(--brown-light));
    color: #fff; font-size: .6rem; font-weight: 800; letter-spacing: .02em; padding: 5px 9px; border-radius: 5px; z-index: 2;
  }
  .wishlist-btn {
    position: absolute; top: 12px; right: 12px; width: 30px; height: 30px; border-radius: 50%; background: #fff;
    border: 1px solid var(--border-soft); display: flex; align-items: center; justify-content: center; color: var(--ink-faint);
    font-size: .78rem; transition: all .2s ease; z-index: 2;
  }
  .wishlist-btn:hover { color: var(--terracotta); border-color: var(--terracotta); }

  .product-body { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 5px; flex: 1; }
  .product-sku { font-size: .6rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-faint); }
  .product-body h3 { font-size: .9rem; font-weight: 700; margin: 0; color: var(--brown-text); line-height: 1.3; }

  .rating-row { display: flex; align-items: center; gap: 6px; margin: 2px 0; }
  .rating-row .stars { color: var(--star); font-size: .72rem; letter-spacing: 1px; }
  .rating-row span { font-size: .72rem; color: var(--ink-faint); font-weight: 600; }
  .ship-tag { display: flex; align-items: center; gap: 5px; font-size: .68rem; color: var(--sage); font-weight: 700; }

  .price-row { display: flex; align-items: baseline; gap: 8px; margin-top: 2px; }
  .price-now { font-size: 1.05rem; font-weight: 800; color: var(--brown-text); }
  .price-was { font-size: .76rem; color: var(--ink-faint); text-decoration: line-through; }
  .price-unavailable { font-size: .8rem; color: var(--ink-faint); font-style: italic; }

  .product-footer { margin-top: auto; padding: 0 16px 16px; }
  .add-cart-btn {
    display: flex; align-items: center; justify-content: center; gap: 7px; background: var(--brown-text); color: #fff;
    border: 2px solid var(--brown-text); border-radius: var(--radius-sm); padding: 9px 15px; font-size: .76rem; font-weight: 700;
    width: 100%; transition: all .2s ease;
  }
  .add-cart-btn:hover { background: transparent; color: var(--brown-text); }
</style>
