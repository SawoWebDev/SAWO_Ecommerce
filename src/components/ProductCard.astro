---
import type { Product } from "../lib/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;

// short_description is stored as rich HTML (see REACT_SITE Supabase rows) —
// strip tags for the plain-text excerpt a card needs.
function stripHtml(html: string | null): string {
  if (!html) return "";
  return html.replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim();
}

const excerpt = stripHtml(product.short_description);
const category = product.categories?.[0] ?? product.brand ?? null;

const hasPrice = product.price !== null && product.price > 0;
const hasDiscount = hasPrice && product.compare_at_price !== null && product.compare_at_price! > product.price!;

const currencyFormatter = new Intl.NumberFormat("en-PH", {
  style: "currency",
  currency: product.currency || "PHP",
  minimumFractionDigits: 0,
  maximumFractionDigits: 2,
});

const STOCK_BADGES: Record<string, { label: string; className: string }> = {
  out_of_stock: { label: "Out of Stock", className: "stock-out" },
  preorder: { label: "Preorder", className: "stock-preorder" },
  backorder: { label: "Backorder", className: "stock-preorder" },
};
// "Low stock" takes priority over a plain in-stock status when both are
// true; a plain in-stock product gets no badge at all (the default,
// unremarkable state doesn't need clutter).
const stockBadge = product.is_low_stock
  ? { label: "Low Stock", className: "stock-low" }
  : product.stock_status
    ? STOCK_BADGES[product.stock_status]
    : null;

const hasRating = product.rating_average !== null && product.rating_average! > 0;
const filledStars = hasRating ? Math.round(product.rating_average! * 2) / 2 : 0;
---
<article class="product-card">
  <div class="product-image">
    {product.thumbnail ? (
      <img src={product.thumbnail} alt={product.name} loading="lazy" />
    ) : (
      <div class="product-image-fallback">
        <i class="fa-regular fa-image"></i>
      </div>
    )}
    <div class="image-badges">
      {product.featured && <span class="badge badge-featured">Featured</span>}
      {stockBadge && <span class={`badge ${stockBadge.className}`}>{stockBadge.label}</span>}
    </div>
  </div>

  <div class="product-body">
    {category && <span class="product-category">{category}</span>}
    <h3 class="product-name">{product.name}</h3>

    {hasRating && (
      <div class="product-rating" aria-label={`Rated ${product.rating_average} out of 5`}>
        <span class="stars">
          {Array.from({ length: 5 }).map((_, i) => {
            const diff = filledStars - i;
            const icon = diff >= 1 ? "fa-solid fa-star" : diff >= 0.5 ? "fa-solid fa-star-half-stroke" : "fa-regular fa-star";
            return <i class={icon}></i>;
          })}
        </span>
        {product.rating_count! > 0 && <span class="rating-count">({product.rating_count})</span>}
      </div>
    )}

    {excerpt && <p class="product-excerpt">{excerpt}</p>}

    <div class="product-footer">
      {hasPrice ? (
        <div class="product-price">
          {hasDiscount && <span class="price-compare">{currencyFormatter.format(product.compare_at_price!)}</span>}
          <span class="price-current">{currencyFormatter.format(product.price!)}</span>
        </div>
      ) : <span class="price-unavailable">Price on request</span>}
      <button class="product-cta" type="button">View Details</button>
    </div>
  </div>
</article>

<style>
  .product-card {
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow .2s ease, transform .2s ease;
  }
  .product-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .product-image {
    position: relative;
    aspect-ratio: 1 / 1;
    background: var(--bg-alt);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 18px;
  }
  .product-image-fallback {
    color: var(--brown-light);
    font-size: 2.5rem;
  }

  .image-badges {
    position: absolute;
    top: 12px;
    left: 12px;
    right: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .badge {
    font-size: .65rem;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 100px;
    color: #fff;
  }
  .badge-featured { background: var(--brown-text); }
  .stock-out { background: #B5502E; }
  .stock-low { background: #C9861D; }
  .stock-preorder { background: #5C7A52; }

  .product-body {
    padding: 16px 18px 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }
  .product-category {
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--brown-text);
  }
  .product-name {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
  }

  .product-rating {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .product-rating .stars { color: #D9A441; font-size: .78rem; letter-spacing: 1px; }
  .product-rating .rating-count { font-size: .72rem; color: var(--ink-faint); }

  .product-excerpt {
    margin: 0;
    font-size: .82rem;
    color: var(--ink-soft);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-footer {
    margin-top: auto;
    padding-top: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .product-price { display: flex; align-items: baseline; gap: 8px; }
  .price-current { font-size: 1rem; font-weight: 700; color: var(--ink); }
  .price-compare {
    font-size: .8rem;
    color: var(--ink-faint);
    text-decoration: line-through;
  }
  .price-unavailable { font-size: .8rem; color: var(--ink-faint); font-style: italic; }

  .product-cta {
    border: none;
    background: none;
    color: var(--brown-deep);
    font-size: .8rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }
  .product-cta::after {
    content: "\2192";
    transition: transform .2s ease;
  }
  .product-card:hover .product-cta::after { transform: translateX(3px); }
</style>
